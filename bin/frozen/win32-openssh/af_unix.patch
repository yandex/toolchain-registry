+
+	if ((wcstombs(pipeid, AGENT_PIPE_ID, sizeof(pipeid)) != (size_t) -1 &&
+	    strcmp(addr->sun_path, pipeid) == 0) ||
+	    strncmp(addr->sun_path, "\\\\.\\pipe\\", 9) == 0)
+		return w32_fileio_socket(SOCK_STREAM, 0);
+	else
+		return w32_unix_socket(SOCK_STREAM, 0);
+	#else
+		return w32_socket(AF_UNIX, SOCK_STREAM, 0);
+	#endif
