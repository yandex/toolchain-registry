+struct pipe_listener_context {
+	wchar_t *name;
+	PSECURITY_DESCRIPTOR security_descriptor;
+};
+
+static int
+pipe_listener_start(struct w32_io *pio)
+{
+	struct pipe_listener_context *ctx = pio->internal.context;
+	SECURITY_ATTRIBUTES sa;
+	BOOL connected;
+	DWORD error;
+
+	memset(&sa, 0, sizeof(sa));
+	sa.nLength = sizeof(sa);
+	sa.lpSecurityDescriptor = ctx->security_descriptor;
+	pio->handle = CreateNamedPipeW(ctx->name,
+	    PIPE_ACCESS_DUPLEX | FILE_FLAG_OVERLAPPED,
+	    PIPE_TYPE_BYTE | PIPE_READMODE_BYTE | PIPE_WAIT |
+	    PIPE_REJECT_REMOTE_CLIENTS, PIPE_UNLIMITED_INSTANCES,
+	    64 * 1024, 64 * 1024, 0, &sa);
+	if (pio->handle == INVALID_HANDLE_VALUE) {
+		errno = errno_from_Win32LastError();
+		return -1;
+	}
+	memset(&pio->read_overlapped, 0, sizeof(pio->read_overlapped));
+	if ((pio->read_overlapped.hEvent = CreateEvent(NULL, TRUE, FALSE, NULL)) == NULL) {
+		errno = errno_from_Win32LastError();
+		CloseHandle(pio->handle);
+		pio->handle = INVALID_HANDLE_VALUE;
+		return -1;
+	}
+	connected = ConnectNamedPipe(pio->handle, &pio->read_overlapped);
+	if (connected) {
+		pio->read_details.remaining = 1;
+	} else {
+		error = GetLastError();
+		if (error == ERROR_PIPE_CONNECTED) {
+			pio->read_details.remaining = 1;
+			SetEvent(pio->read_overlapped.hEvent);
+		}
+		else if (error != ERROR_IO_PENDING) {
+			errno = errno_from_Win32Error(error);
+			CloseHandle(pio->read_overlapped.hEvent);
+			CloseHandle(pio->handle);
+			pio->read_overlapped.hEvent = NULL;
+			pio->handle = INVALID_HANDLE_VALUE;
+			return -1;
+		}
+	}
+	pio->read_details.pending = pio->read_details.remaining == 0;
+	return 0;
+}
+
+struct w32_io*
+fileio_pipe_listener(const char *name)
+{
+	struct pipe_listener_context *ctx = NULL;
+	struct w32_io *pio = NULL;
+	PSID sid = NULL;
+	LPWSTR sid_string = NULL;
+	wchar_t sddl[SDDL_LENGTH];
+
+	if ((sid = get_sid(NULL)) == NULL ||
+	    !ConvertSidToStringSidW(sid, &sid_string))
+		goto fail;
+	if (swprintf_s(sddl, SDDL_LENGTH,
+	    L"O:%sD:P(A;;GA;;;%s)(A;;GA;;;SY)(A;;GA;;;BA)",
+	    sid_string, sid_string) < 0)
+		goto fail;
+	if ((ctx = calloc(1, sizeof(*ctx))) == NULL ||
+	    (pio = calloc(1, sizeof(*pio))) == NULL ||
+	    (ctx->name = utf8_to_utf16(name)) == NULL)
+		goto fail;
+	if (!ConvertStringSecurityDescriptorToSecurityDescriptorW(sddl,
+	    SDDL_REVISION_1, &ctx->security_descriptor, NULL))
+		goto fail;
+	pio->internal.context = ctx;
+	pio->internal.state = SOCK_LISTENING;
+	pio->handle = INVALID_HANDLE_VALUE;
+	if (pipe_listener_start(pio) != 0)
+		goto fail;
+	free(sid);
+	LocalFree(sid_string);
+	return pio;
+fail:
+	if (sid != NULL)
+		free(sid);
+	if (sid_string != NULL)
+		LocalFree(sid_string);
+	if (ctx != NULL) {
+		free(ctx->name);
+		if (ctx->security_descriptor != NULL)
+			LocalFree(ctx->security_descriptor);
+		free(ctx);
+	}
+	free(pio);
+	if (errno == 0)
+		errno = EACCES;
+	return NULL;
+}
+
+BOOL
+fileio_pipe_listener_available(struct w32_io *pio)
+{
+	DWORD transferred;
+
+	if (pio->read_details.remaining != 0)
+		return TRUE;
+	if (GetOverlappedResult(pio->handle, &pio->read_overlapped,
+	    &transferred, FALSE))
+		return TRUE;
+	if (GetLastError() == ERROR_IO_INCOMPLETE)
+		return FALSE;
+	pio->read_details.error = GetLastError();
+	return TRUE;
+}
+
+struct w32_io*
+fileio_pipe_accept(struct w32_io *listener)
+{
+	struct w32_io *accepted;
+
+	while (!fileio_pipe_listener_available(listener)) {
+		if (!w32_io_is_blocking(listener)) {
+			errno = EAGAIN;
+			return NULL;
+		}
+		if (wait_for_any_event(&listener->read_overlapped.hEvent,
+		    1, INFINITE) == -1)
+			return NULL;
+	}
+	if (listener->read_details.error != 0) {
+		errno = errno_from_Win32Error(listener->read_details.error);
+		listener->read_details.error = 0;
+		return NULL;
+	}
+	if ((accepted = calloc(1, sizeof(*accepted))) == NULL) {
+		errno = ENOMEM;
+		return NULL;
+	}
+	accepted->handle = listener->handle;
+	listener->handle = INVALID_HANDLE_VALUE;
+	CloseHandle(listener->read_overlapped.hEvent);
+	listener->read_overlapped.hEvent = NULL;
+	listener->read_details.pending = FALSE;
+	listener->read_details.remaining = 0;
+	if (pipe_listener_start(listener) != 0)
+		debug3("failed to create next forwarded-agent pipe instance: %d", errno);
+	return accepted;
+}
+
+int
+fileio_pipe_listener_close(struct w32_io *pio)
+{
+	struct pipe_listener_context *ctx = pio->internal.context;
+
+	if (pio->handle != INVALID_HANDLE_VALUE) {
+		CancelIo(pio->handle);
+		CloseHandle(pio->handle);
+	}
+	if (pio->read_overlapped.hEvent != NULL)
+		CloseHandle(pio->read_overlapped.hEvent);
+	if (ctx != NULL) {
+		free(ctx->name);
+		if (ctx->security_descriptor != NULL)
+			LocalFree(ctx->security_descriptor);
+		free(ctx);
+	}
+	free(pio);
+	return 0;
+}
